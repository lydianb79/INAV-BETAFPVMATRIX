)
list(TRANSFORM STM32G4_USBHID_SRC PREPEND "${STM32G4_USBHID_DIR}/Src/")

set(STM32G4_USBMSC_DIR "${MAIN_LIB_DIR}/main/STM32G4/Middlewares/ST/STM32_USB_Device_Library/Class/MSC")
set(STM32G4_USBMSC_SRC

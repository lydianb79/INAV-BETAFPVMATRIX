list(TRANSFORM STM32G4_USBCORE_SRC PREPEND "${STM32G4_USBCORE_DIR}/Src/")

set(STM32G4_USBCDC_DIR "${MAIN_LIB_DIR}/main/STM32G4/Middlewares/ST/STM32_USB_Device_Library/Class/CDC")
